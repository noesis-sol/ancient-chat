# Copy to .env (or .env.local) and fill in. Both files are gitignored.
# The server checks these at startup (src/lib/env.ts) and exits naming any
# required variable that is missing or malformed.

# --- Required -----------------------------------------------------------------

# PostgreSQL connection string, used by Prisma (prisma/schema.prisma).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ancient_chat

# Pinecone API key (https://app.pinecone.io). Holds one vector index per
# uploaded source folder.
PINECONE_API_KEY=

# OpenAI API key, used for embeddings and the chat model.
OPENAI_API_KEY=

# Clerk keys (https://dashboard.clerk.com > API keys). The publishable key is
# also inlined into the client bundle at build time, so `next build` needs it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Optional -----------------------------------------------------------------

# Send sign-in and sign-up to the app's own pages. Without these, Clerk
# redirects protected pages to its hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Shadow database for `npx prisma migrate diff --from-migrations` (see
# prisma.config.ts). Not needed by the app or by `prisma migrate dev`.
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ancient_chat_shadow

# Where new Pinecone serverless indexes are created. Defaults: aws, us-east-1.
# PINECONE_CLOUD is one of aws, gcp, azure; the region must be one Pinecone
# offers on that cloud. Existing indexes are not moved.
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Pinecone Local (an in-memory emulator) for development and tests, instead of
# Pinecone's cloud. Any PINECONE_API_KEY value works with it. See README.md,
# "Local Pinecone".
# PINECONE_CONTROLLER_HOST=http://localhost:5080
