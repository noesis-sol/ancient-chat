{
  "name": "ancient-chat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test && node scripts/check-build.mjs",
    "e2e": "start-server-and-test start http://localhost:3000/favicon.ico cypress:run",
    "e2e:open": "start-server-and-test dev http://localhost:3000/favicon.ico cypress:open",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.130",
    "@clerk/nextjs": "^6.11.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@heroicons/react": "^2.2.0",
    "@langchain/core": "^0.3.37",
    "@langchain/openai": "^0.4.2",
    "@pinecone-database/pinecone": "^8.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.127",
    "langchain": "^0.3.15",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "openai": "^4.82.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.42",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "cypress": "^15.21.1",
    "daisyui": "^5.0.0-beta.6",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.1",
    "prisma": "^7.10.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.0.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
